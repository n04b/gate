# Copy to .env — never commit the real values.

# Cloudflare Tunnel token for the cloudflared service in docker-compose.yml.
# Route the tunnel's public hostname to http://gate:6473.
TUNNEL_TOKEN=

# Default `issued_by` recorded in the token log when --issued-by is omitted.
GATE_ISSUED_BY=homelab

# Cloudflare Access service token secrets for external services.
#
# A service in gate.yaml names the variable it reads, so the secret stays out
# of the bind-mounted config file:
#
#   services:
#     router:
#       url: https://router.example.workers.dev
#       access:
#         client_id: abc123.access
#         client_secret_env: CF_ACCESS_SECRET_ROUTER
#
# Create the token under Zero Trust > Access > Service Auth, and pass the
# variable through to the gate service in docker-compose.yml.
# CF_ACCESS_SECRET_ROUTER=
